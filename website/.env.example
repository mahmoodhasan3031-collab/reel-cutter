# Reel Cutter website - public environment contract (STEP 53 / P1-1)
#
# Every NEXT_PUBLIC_* value below is compiled into the browser bundle, so it
# is public by definition. NEVER put a secret here: no Stripe secret key, no
# Supabase service-role key, no session/HMAC secret, no database URL.
#
# REQUIRED FOR PRODUCTION BUILDS.
# `npm run build` (prebuild -> scripts/verify-public-env.mjs) fails when a
# required variable is missing, points at localhost, or has an invalid value.
# Local development (`npm run dev`) still works with empty values.

# Supabase Configuration (required for authentication)
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API URL (required for checkout, admin, license dashboard)
# Local development: http://localhost:3001
# Production: https://reel-cutter.onrender.com
NEXT_PUBLIC_API_BASE_URL=

# Optional legacy alias for NEXT_PUBLIC_API_BASE_URL. Used only when
# NEXT_PUBLIC_API_BASE_URL is empty.
NEXT_PUBLIC_SERVER_URL=

# Stripe checkout mode. REQUIRED for production builds; must be exactly
# "test" or "live". The client-side isLive flag is derived from this value,
# so the site can never advertise live payments while running in test mode.
#   test - Stripe test/sandbox mode (cards are not charged)
#   live - Stripe live mode (real charges)
NEXT_PUBLIC_STRIPE_MODE=

# Manual payment destinations (client-visible, shown to customers on /payment/manual)
NEXT_PUBLIC_BKASH_NUMBER=
NEXT_PUBLIC_NAGAD_NUMBER=
NEXT_PUBLIC_ROCKET_NUMBER=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BINANCE_PAY_ID=
