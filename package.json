{
  "name": "reel-cutter",
  "productName": "Reel Cutter",
  "version": "1.0.0",
  "description": "AI-powered video cutter, 9:16 vertical reel maker, smart crop, and batch processing engine.",
  "main": "out/main/index.js",
  "bin": {
    "reel-cutter": "./src/cli.js"
  },
  "scripts": {
    "dev": "electron-vite dev --config electron.vite.config.mjs",
    "build": "electron-vite build --config electron.vite.config.mjs",
    "preview": "electron-vite preview --config electron.vite.config.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "cli": "node src/cli.js",
    "server": "node server/index.js",
    "test": "node test/runAllTests.js"
  },
  "keywords": [
    "video",
    "ffmpeg",
    "reel",
    "cutter",
    "smart-crop",
    "batch"
  ],
  "author": "Reel Cutter Inc.",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^1.41.0",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^10.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.3"
  },
  "allowScripts": {
    "electron@44.2.0": true
  }
}
