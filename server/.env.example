# ==============================================================================
# Reel Cutter Server — Environment Variables
# Copy this file to .env and fill in production values
# ==============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
CORS_ALLOWED_ORIGINS=https://reelcutter.app,https://www.reelcutter.app

# ─── Supabase (Database) ─────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Stripe (Payments — Monthly Subscriptions) ────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_BASIC=price_your-basic-monthly-price-id
STRIPE_PRICE_STANDARD=price_your-standard-monthly-price-id
STRIPE_PRICE_PRO=price_your-pro-monthly-price-id

# ─── Email (License Delivery) ─────────────────────────────────────────────────
# Option 1: Resend API (recommended)
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=Reel Cutter <support@reelcutter.app>

# Option 2: SMTP (alternative)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password

# ─── Admin Authentication (STEP 19 — payment review backend) ─────────────────
# Never commit real values. Never use a plaintext password here.
#
# 1. Generate a scrypt password hash (do NOT put the plain password in .env):
#      node server/scripts/generateAdminPasswordHash.js "your-strong-password"
# 2. Put the resulting scrypt$... value in ADMIN_PASSWORD_HASH.
# 3. Generate a random session secret, e.g.:
#      node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-hash
ADMIN_SESSION_SECRET=replace-with-random-64+-char-secret
# Optional: admin session lifetime in seconds (default 1800 = 30 minutes)
# ADMIN_SESSION_TTL_SECONDS=1800

# ─── App ──────────────────────────────────────────────────────────────────────
APP_DOWNLOAD_URL=https://reelcutter.app/download
