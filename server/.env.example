# ==============================================================================
# Reel Cutter Server — Environment Variables
# Copy this file to .env and fill in production values
# ==============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
CORS_ALLOWED_ORIGINS=https://reelcutter.app,https://www.reelcutter.app

# ─── Supabase (Database) ─────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Stripe (Payments) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_BASIC=price_your-basic-price-id
STRIPE_PRICE_STANDARD=price_your-standard-price-id
STRIPE_PRICE_PRO=price_your-pro-price-id

# ─── Email (License Delivery) ─────────────────────────────────────────────────
# Option 1: Resend API (recommended)
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=Reel Cutter <support@reelcutter.app>

# Option 2: SMTP (alternative)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password

# ─── App ──────────────────────────────────────────────────────────────────────
APP_DOWNLOAD_URL=https://reelcutter.app/download
